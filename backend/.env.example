# Copy to .env and edit. Every field here is read by app/config.py (Settings) --
# nothing else in the backend should ever read os.environ directly.
#
# This one file is the entire difference between deployment targets: point
# OPENAI_BASE_URL at a different Ollama (or any OpenAI-compatible host) and
# nothing else changes.

ENVIRONMENT=dev
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Database ---
DATABASE_URL=postgresql+psycopg2://cwuser:cwpass@localhost:5432/clinician_dev

# --- Auth --- (generate a real secret for anything beyond your own laptop: `openssl rand -hex 32`)
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- SSO / MFA placeholders --- (see README "Auth & RBAC" section -- hooks exist, not implemented)
SSO_ENABLED=false
MFA_ENABLED=false

# --- LLM gateway (app/services/llm_gateway.py is the ONLY module that reads these) ---
# DEV (this file's defaults):        http://localhost:11434/v1  -- Ollama running on this machine
# RAILWAY POC:                       https://<your-tunnel-host>/v1  -- Ollama on the Mac Mini via a
#                                     Cloudflare Tunnel/ngrok, or any OpenAI-compatible open-weights
#                                     host. Synthetic data only in this mode -- see README.
# CLIENT ON-PREM:                    http://<onprem-ollama-host>:11434/v1 -- PHI never leaves this
#                                     network; nothing here should ever be a public internet host
#                                     when real patient data is loaded.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
CHAT_MODEL=qwen3:14b
EXTRACTION_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
LLM_CONTEXT_TOKENS=12000
LLM_KEEP_ALIVE=30m
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# auto  = probe the gateway, fall back to mock automatically if unreachable (good default for dev)
# live  = always call the real gateway; a down gateway surfaces as an explicit "model unavailable"
#         state in the UI instead of silently degrading -- use this in the CLIENT deployment once
#         Ollama is confirmed up, so a real outage is visible rather than quietly mocked.
# mock  = never call a real model. The whole app (including curation and chat) still works with
#         deterministic rule-based stand-ins -- useful for UI dev/demos with zero LLM configured.
LLM_MODE=auto

# --- Ingestion ---
MAX_UPLOAD_MB=50
UPLOAD_DIR=./data/uploads
