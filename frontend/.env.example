# Only used by `vite dev` (server.proxy target in vite.config.ts) for local
# development, so the dev server knows where to forward /api requests.
# The production build (Docker/Railway) doesn't use this at all -- nginx does
# the /api proxying instead, configured via BACKEND_INTERNAL_URL (see
# frontend/nginx.conf.template and docker-compose.yml / railway.json).
VITE_API_PROXY_TARGET=http://localhost:8000
