# Templated by the nginx:alpine entrypoint (envsubst) at container start, so
# BACKEND_INTERNAL_URL can be set per deployment target without a rebuild:
#   docker-compose: BACKEND_INTERNAL_URL=http://backend:8000        (compose service name)
#   Railway:        BACKEND_INTERNAL_URL=http://<backend>.railway.internal:8000
#                    (Railway private networking hostname for the backend service)
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_INTERNAL_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE chat streaming needs buffering off and a generous read timeout.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri /index.html;
    }
}
